{
  "subjects": {
    "portugues": {
      "easy": [
        {
          "q": "[Caso 7] Identifique a flexão de número correta: Na frase \"Os guarda-chuvas da nação precisam votar\", qual é o plural gramatical adequado de \"guarda-chuva\"?",
          "a": "guarda-chuvas",
          "d": [
            "guardas-chuva",
            "guardas-chuvas",
            "guarda-chuvae"
          ],
          "explanation": "De acordo com a norma-padrão da Língua Portuguesa, o plural de 'guarda-chuva' é 'guarda-chuvas'. Se o primeiro termo for verbo (guarda), ele não flexiona. Apenas o substantivo (chuvas) vai para o plural.",
          "hint": "Preste atenção nas terminações em -ão e nas exceções de palavras paroxítonas terminadas em -r.",
          "concept": "EM13LGG101"
        },
        {
          "q": "[Caso 9] Identifique a flexão de número correta: Na frase \"Os pão-de-lós da nação precisam votar\", qual é o plural gramatical adequado de \"pão-de-ló\"?",
          "a": "pães-de-ló",
          "d": [
            "pão-de-lós",
            "pães-de-lós",
            "pão-des-lós"
          ],
          "explanation": "De acordo com a norma-padrão da Língua Portuguesa, o plural de 'pão-de-ló' é 'pães-de-ló'. Em substantivos compostos com elementos de ligação (de), apenas o primeiro elemento vai para o plural.",
          "hint": "Preste atenção nas terminações em -ão e nas exceções de palavras paroxítonas terminadas em -r.",
          "concept": "EM13LGG301"
        },
        {
          "q": "[Caso 11] Identifique a flexão de número correta: Na frase \"Os cidadãos da nação precisam votar\", qual é o plural gramatical adequado de \"cidadão\"?",
          "a": "cidadãos",
          "d": [
            "cidadões",
            "cidadães",
            "cidadãoes"
          ],
          "explanation": "De acordo com a norma-padrão da Língua Portuguesa, o plural de 'cidadão' é 'cidadãos'. Cidadão vem de cidade; assim como irmãos moram juntos, cidadãos compartilham a mesma comunidade.",
          "hint": "Preste atenção nas terminações em -ão e nas exceções de palavras paroxítonas terminadas em -r.",
          "concept": "EM13LGG101"
        },
        {
          "q": "[Caso 10] Identifique a flexão de número correta: Na frase \"Os decreto-leis da nação precisam votar\", qual é o plural gramatical adequado de \"decreto-lei\"?",
          "a": "decretos-lei",
          "d": [
            "decreto-leis",
            "decretos-leis",
            "decreto-leiy"
          ],
          "explanation": "De acordo com a norma-padrão da Língua Portuguesa, o plural de 'decreto-lei' é 'decretos-lei'. Quando o segundo substantivo limita ou especifica o primeiro, pode-se flexionar apenas o primeiro ou ambos (decretos-lei ou decretos-leis).",
          "hint": "Preste atenção nas terminações em -ão e nas exceções de palavras paroxítonas terminadas em -r.",
          "concept": "EM13LGG301"
        },
        {
          "q": "[Caso 14] Identifique a flexão de número correta: Na frase \"Os tabeliãos da nação precisam votar\", qual é o plural gramatical adequado de \"tabelião\"?",
          "a": "tabeliães",
          "d": [
            "tabeliãos",
            "tabeliões",
            "tabeliãoes"
          ],
          "explanation": "De acordo com a norma-padrão da Língua Portuguesa, o plural de 'tabelião' é 'tabeliães'. Tabelião atua no cartório registrando papéis. Pense em escrivães, que também terminam em -ães no plural!",
          "hint": "Preste atenção nas terminações em -ão e nas exceções de palavras paroxítonas terminadas em -r.",
          "concept": "EM13LGG301"
        },
        {
          "q": "[Caso 1] Identifique a flexão de número correta: Na frase \"Os cidadãos da nação precisam votar\", qual é o plural gramatical adequado de \"cidadão\"?",
